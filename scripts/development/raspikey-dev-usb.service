[Unit]
Description=RaspiKey development USB network and keyboard
After=systemd-modules-load.service
Before=raspikey-dev.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/raspikey/usb-gadget.sh start
ExecStop=/usr/local/libexec/raspikey/usb-gadget.sh stop
TimeoutStartSec=30
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
